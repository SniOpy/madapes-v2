HOST=
PORT=
NODE_ENV=
# Comma-separated values. Supports exact origins and '*' wildcard patterns.
# Example: https://madapes-v2.vercel.app,https://*.vercel.app,http://localhost:5500
CORS_ALLOWED_ORIGINS=
SITE_BASE_URL=

MAIL_USER=
MAIL_PASSWORD=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_NETWORK_FAMILY=4
MAIL_CONNECTION_TIMEOUT_MS=10000
MAIL_GREETING_TIMEOUT_MS=10000
MAIL_SOCKET_TIMEOUT_MS=15000
MAIL_SEND_TIMEOUT_MS=12000

# Optional fallback when SMTP is blocked in cloud environments
RESEND_API_KEY=
RESEND_FROM_EMAIL=