{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "installCommand": "npm ci --omit=dev",
  "buildCommand": "",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/cgs",
      "destination": "/conditions-generales-de-service",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://madapes-v2.onrender.com/api/:path*"
    },
    {
      "source": "/services",
      "destination": "/pages/services"
    },
    {
      "source": "/tracking",
      "destination": "/pages/tracking"
    },
    { "source": "/offres", "destination": "/pages/offres" },
    { "source": "/starter", "destination": "/pages/starter" },
    { "source": "/growth", "destination": "/pages/growth" },
    { "source": "/performance", "destination": "/pages/performance" },
    { "source": "/blog", "destination": "/pages/blog" },
    {
      "source": "/realisations",
      "destination": "/pages/realisations"
    },
    {
      "source": "/google-ads",
      "destination": "/pages/google-ads"
    },
    {
      "source": "/landing-pages",
      "destination": "/pages/landing-pages"
    },
    { "source": "/seo", "destination": "/pages/seo" },
    { "source": "/contact", "destination": "/pages/contact" },
    { "source": "/devis", "destination": "/pages/devis" },
    {
      "source": "/plan-du-site",
      "destination": "/pages/plan-du-site"
    },
    {
      "source": "/conditions-generales-de-service",
      "destination": "/pages/conditions-generales-de-service"
    },
    {
      "source": "/mentions-legales",
      "destination": "/pages/mentions-legales"
    },
    {
      "source": "/politique-confidentialite",
      "destination": "/pages/politique-confidentialite"
    },
    {
      "source": "/gestion-cookies",
      "destination": "/pages/gestion-cookies"
    },
    { "source": "/en", "destination": "/en/index" },
    { "source": "/en/services", "destination": "/pages/en/services" },
    { "source": "/en/tracking", "destination": "/pages/en/tracking" },
    { "source": "/en/offers", "destination": "/pages/en/offers" },
    { "source": "/en/starter", "destination": "/pages/en/starter" },
    { "source": "/en/growth", "destination": "/pages/en/growth" },
    { "source": "/en/performance", "destination": "/pages/en/performance" },
    { "source": "/en/blog", "destination": "/pages/en/blog" },
    { "source": "/en/work", "destination": "/pages/en/work" },
    { "source": "/en/google-ads", "destination": "/pages/en/google-ads" },
    { "source": "/en/landing-pages", "destination": "/pages/en/landing-pages" },
    { "source": "/en/seo", "destination": "/pages/en/seo" },
    { "source": "/en/contact", "destination": "/pages/en/contact" },
    { "source": "/en/quote", "destination": "/pages/en/quote" },
    { "source": "/en/sitemap", "destination": "/pages/en/sitemap" },
    { "source": "/en/terms", "destination": "/pages/en/terms" },
    { "source": "/en/legal-notice", "destination": "/pages/en/legal-notice" },
    { "source": "/en/privacy", "destination": "/pages/en/privacy" },
    { "source": "/en/cookies", "destination": "/pages/en/cookies" }
  ]
}
