{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "npm ci --omit=dev",
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://madapes-v2.onrender.com/api/:path*"
    },
    { "source": "/services", "destination": "/pages/services.html" },
    { "source": "/tracking", "destination": "/pages/tracking.html" },
    { "source": "/offres", "destination": "/pages/offres.html" },
    { "source": "/blog", "destination": "/pages/blog.html" },
    { "source": "/realisations", "destination": "/pages/realisations.html" },
    { "source": "/google-ads", "destination": "/pages/google-ads.html" },
    { "source": "/landing-pages", "destination": "/pages/landing-pages.html" },
    { "source": "/seo", "destination": "/pages/seo.html" },
    { "source": "/contact", "destination": "/pages/contact.html" },
    { "source": "/devis", "destination": "/pages/devis.html" },
    { "source": "/plan-du-site", "destination": "/pages/plan-du-site.html" },
    { "source": "/cgs", "destination": "/pages/cgs.html" },
    { "source": "/mentions-legales", "destination": "/pages/mentions-legales.html" },
    {
      "source": "/politique-confidentialite",
      "destination": "/pages/politique-confidentialite.html"
    },
    { "source": "/gestion-cookies", "destination": "/pages/gestion-cookies.html" }
  ]
}
